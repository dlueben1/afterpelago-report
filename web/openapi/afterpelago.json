  "components": {
    "schemas": {
      "AntiforgeryTokenResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "CheckResponse": {
        "required": [
          "id",
          "timestampUtc",
          "teamNumber",
          "senderSlotId",
          "senderName",
          "receiverSlotId",
          "receiverName",
          "itemName",
          "locationName",
          "sourceLineNumber"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "teamNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "senderSlotId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "senderName": {
            "type": "string"
          },
          "receiverSlotId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "receiverName": {
            "type": "string"
          },
          "itemName": {
            "type": "string"
          },
          "locationName": {
            "type": "string"
          },
          "sourceLineNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ConnectionResponse": {
        "required": [
          "id",
          "timestampUtc",
          "action",
          "kind",
          "clientVersion",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "clientVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CounterResponse": {
        "required": [
          "value",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DatabaseInfoResponse": {
        "required": [
          "path",
          "sizeGb"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sizeGb": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportCountsResponse": {
        "required": [
          "slots",
          "checks",
          "hints",
          "events",
          "gameplayConnections",
          "trackerConnections"
        ],
        "type": "object",
        "properties": {
          "slots": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "checks": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hints": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "events": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "gameplayConnections": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "trackerConnections": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ImportWarningResponse": {
        "required": [
          "lineNumber",
          "reason"
        ],
        "type": "object",
        "properties": {
          "lineNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PublishSessionRequest": {
        "required": [
          "sourceUtcOffsetMinutes"
        ],
        "type": "object",
        "properties": {
          "sourceUtcOffsetMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "SamplePoint": {
        "required": [
          "label",
          "value"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ServerDataResponse": {
        "required": [
          "greeting",
          "serverTime",
          "randomValue",
          "samples"
        ],
        "type": "object",
        "properties": {
          "greeting": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "randomValue": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "samples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SamplePoint"
            }
          }
        }
      },
      "SessionDetailsResponse": {
        "required": [
          "id",
          "name",
          "startUtc",
          "endUtc",
          "slots",
          "imports",
          "status",
          "isFavorite",
          "checkCount",
          "hintCount",
          "totalPlaytimeSeconds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "startUtc": {
            "type": "string",
            "format": "date-time"
          },
          "endUtc": {
            "type": "string",
            "format": "date-time"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionSlotResponse"
            }
          },
          "imports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionImportInfoResponse"
            }
          },
          "status": {
            "type": "string"
          },
          "isFavorite": {
            "type": "boolean"
          },
          "checkCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "hintCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "totalPlaytimeSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SessionFavoriteResponse": {
        "required": [
          "sessionId",
          "isFavorite"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isFavorite": {
            "type": "boolean"
